# Copy to app/.env and fill in.

# Anthropic API key from https://platform.claude.com/ (used by the Claude Agent SDK)
ANTHROPIC_API_KEY=sk-ant-...

# Login password for the web app (use a long random one: `openssl rand -base64 24`)
STUDY_PASSWORD=change-me
# Secret for signing the login cookie (`openssl rand -hex 32`)
STUDY_SECRET=change-me-too

# Port the server listens on (127.0.0.1)
PORT=3000

# Optional
# STUDY_MODEL=claude-opus-5-5      # Claude model for the tutor
# BASE_PATH=/study                 # if served below a sub-path behind a reverse proxy
# DATA_DIR=./data                  # where the database, uploads and videos are stored
# PYTHON=../.venv/bin/python       # Python with pymupdf and edge-tts
# CONFIG_DIR=./config              # folder with modules.json / student.md
# LIBRARY_DIR=../library           # folder whose PDFs are imported on start
